                "api",
                "v1",
                "entities"
              ],
              "query": [
                {
                  "description": "Page number",
                  "disabled": true,
                  "key": "page",
                  "value": "1"
                },
                {
                  "description": "Items per page",
                  "disabled": true,
                  "key": "size",
                  "value": "20"
                },
                {
                  "description": "Search by legal name or EIN",
                  "disabled": true,
                  "key": "search",
                  "value": ""
