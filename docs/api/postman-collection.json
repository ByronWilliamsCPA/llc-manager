{
  "info": {
    "_postman_id": "llc-manager-api-collection",
    "description": "REST API for managing LLC entities, ownership structures, compliance dates, bank accounts, tax filings, and associated documentation.\n\nAll resource endpoints are namespaced under `/api/v1/` to match the API version `1.0.0`. Health probe endpoints are exposed under `/api/health/` and follow Kubernetes probe conventions.",
    "name": "LLC Manager API (Postman)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    }
  },
  "item": [
    {
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"List documents returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"List documents returns a JSON body\", function () {",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "    var body = pm.response.json();",
                  "    pm.expect(body, \"JSON body\").to.satisfy(function (value) {",
                  "        return value !== null && (typeof value === \"object\" || Array.isArray(value));",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "List documents",
          "request": {
            "description": "Return document metadata, oldest `updated_at` first, so a consumer can page through changes. `updated_since` returns documents created or replaced at or after the given time (a timestamp without a zone is read as UTC). Soft-deleted documents are excluded.",
            "header": [
              {
                "key": "Accept",
                "type": "text",
                "value": "application/json"
              },
              {
                "description": "Supplied via Postman environment variable.",
                "key": "X-API-Key",
                "type": "text",
                "value": "{{apiKey}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents"
              ],
              "query": [
                {
                  "description": "Page number",
                  "disabled": true,
                  "key": "page",
                  "value": "1"
                },
                {
                  "description": "Items per page",
                  "disabled": true,
                  "key": "size",
                  "value": "50"
                },
                {
                  "description": "Only documents updated at or after this time",
                  "disabled": true,
                  "key": "updated_since",
                  "value": ""
                },
                {
                  "description": "Filter by entity",
                  "disabled": true,
                  "key": "entity_id",
                  "value": ""
                },
                {
                  "description": "Filter by category",
                  "disabled": true,
                  "key": "category",
                  "value": ""
                }
              ],
              "raw": "{{baseUrl}}/api/v1/documents?",
              "variable": []
            }
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get document metadata returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Get document metadata returns a JSON body\", function () {",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "    var body = pm.response.json();",
                  "    pm.expect(body, \"JSON body\").to.satisfy(function (value) {",
                  "        return value !== null && (typeof value === \"object\" || Array.isArray(value));",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get document metadata",
          "request": {
            "description": "Return one document's metadata.\n\nArgs:\n    db (DBSession): Database session.\n    document_id (UUID): Document ID.\n\nReturns:\n    DocumentRead: The document metadata.",
            "header": [
              {
                "key": "Accept",
                "type": "text",
                "value": "application/json"
              },
              {
                "description": "Supplied via Postman environment variable.",
                "key": "X-API-Key",
                "type": "text",
                "value": "{{apiKey}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                ":document_id"
              ],
              "query": [],
              "raw": "{{baseUrl}}/api/v1/documents/:document_id",
              "variable": [
                {
                  "description": "",
                  "key": "document_id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            }
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Download document file returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Download document file returns an empty body\", function () {",
                  "    pm.expect(pm.response.text() || \"\").to.have.lengthOf.at.most(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Download document file",
          "request": {
            "description": "Stream the stored file with its MIME type and `Content-Length`. The file is located by document ID under the server's documents root; no path is accepted from the caller.",
            "header": [
              {
                "key": "Accept",
                "type": "text",
                "value": "application/json"
              },
              {
                "description": "Supplied via Postman environment variable.",
                "key": "X-API-Key",
                "type": "text",
                "value": "{{apiKey}}"
              }
            ],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                ":document_id",
                "file"
              ],
              "query": [],
              "raw": "{{baseUrl}}/api/v1/documents/:document_id/file",
              "variable": [
                {
                  "description": "",
                  "key": "document_id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "name": "Documents"
    },
